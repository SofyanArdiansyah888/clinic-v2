# Salin ke .env.qa (tidak di-commit) lalu isi. Tanpa QA_BASE_URL, suite jalan ke stack e2e lokal.
# HANYA staging. Config menolak host yang tidak terlihat seperti staging kecuali QA_ALLOW_HOST diisi.
QA_BASE_URL=https://staging.klinik-anda.com
# QA_ALLOW_HOST=klinik-staging-internal.example.net

# Admin staging: dipakai untuk membuat data uji (staff, treatment, barang, stok) dan akun e2e_<role>.
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=
# Password untuk akun e2e_doctor, e2e_staff, e2e_apoteker, e2e_nurse, e2e_finance yang dibuat otomatis.
E2E_ROLE_PASSWORD=
